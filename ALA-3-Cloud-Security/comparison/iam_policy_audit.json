{
  "audit_name": "GMIU Cloud Security Feature & IAM Policy Audit",
  "candidate": "Herry Prajapati (20230905090031)",
  "reference_platform": "Amazon Web Services (AWS)",
  "policy_evaluations": [
    {
      "policy_name": "GMIU_Student_S3_Submissions_Policy",
      "type": "Customer Managed IAM Policy",
      "statement": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "AllowStudentReadWriteOwnDirectory",
            "Effect": "Allow",
            "Action": [
              "s3:PutObject",
              "s3:GetObject",
              "s3:ListBucket"
            ],
            "Resource": [
              "arn:aws:s3:::gmiu-cloud-ala-submissions/20230905090031/*",
              "arn:aws:s3:::gmiu-cloud-ala-submissions"
            ],
            "Condition": {
              "Bool": {
                "aws:SecureTransport": "true"
              },
              "NumericLessThanEquals": {
                "s3:TlsVersion": 1.3
              }
            }
          },
          {
            "Sid": "ExplicitDenyNonTLS",
            "Effect": "Deny",
            "Action": "s3:*",
            "Resource": "arn:aws:s3:::gmiu-cloud-ala-submissions/*",
            "Condition": {
              "Bool": {
                "aws:SecureTransport": "false"
              }
            }
          }
        ]
      },
      "compliance_status": "Passed NIST SP 800-53 AC-6 Least Privilege"
    },
    {
      "policy_name": "GMIU_KMS_Envelope_Key_Policy",
      "type": "Key Policy for Customer Master Key (CMK)",
      "statement": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "EnableKeyRotation",
            "Effect": "Allow",
            "Principal": { "AWS": "arn:aws:iam::123456789012:root" },
            "Action": "kms:*",
            "Resource": "*"
          },
          {
            "Sid": "AllowEnvelopeEncryptionOperations",
            "Effect": "Allow",
            "Principal": { "AWS": "arn:aws:iam::123456789012:role/GMIU_Submission_Worker" },
            "Action": [
              "kms:GenerateDataKey",
              "kms:Decrypt"
            ],
            "Resource": "*"
          }
        ]
      },
      "compliance_status": "FIPS 140-2 Level 3 Validated"
    }
  ]
}
